{
  "name": "@lerna-labs/ekklesia-ui",
  "version": "0.0.0",
  "description": "Shared Svelte components and theme for the Ekklesia platform",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "lint": "eslint . && prettier --check .",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "test": "echo \"No tests yet\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish",
    "changeset:snapshot": "changeset version --snapshot rc"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lerna-labs/ekklesia-ui.git"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "publint": "^0.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  }
}
